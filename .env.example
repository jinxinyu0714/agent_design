# API Keys Configuration Template
# Copy this file to .env and fill in your actual API keys

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Google Search API Configuration
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-google-cse-id-here

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Tencent Cloud API Configuration (for Hunyuan3D)
TENCENTCLOUD_SECRET_ID=your-tencentcloud-secret-id-here
TENCENTCLOUD_SECRET_KEY=your-tencentcloud-secret-key-here

# Path Configuration (Optional)
# Note: Most paths are automatically configured relative to the project root
# You typically don't need to modify these unless you have a custom setup
# OUTPUT_DIR=/path/to/your/output/directory
